import { IUserRepositoryPort } from './ports/outbound/IUserRepositoryPort';
import { StripeAdapter } from '../adapters/outbound/StripeAdapter';

export class PaymentService {
    constructor(
        private readonly userRepository: IUserRepositoryPort,
        private readonly stripeAdapter: StripeAdapter,
    ) {}

    async createCheckoutSession(userId: string, priceId: string) {
        const user = await this.userRepository.findById(userId);
        if (!user) throw new Error('User not found');

        let customerId = user.stripeCustomerId;

        if (!customerId) {
            const customer = await this.stripeAdapter.createCustomer(
                user.email,
                user.name,
                user.id!,
            );
            customerId = customer.id;
            const updatedUser = user.withStripeCustomerId(customerId);
            await this.userRepository.save(updatedUser);
        }

        return this.stripeAdapter.createCheckoutSession(
            customerId,
            priceId,
            `${process.env.FRONTEND_URL}/success?session_id={CHECKOUT_SESSION_ID}`,
            `${process.env.FRONTEND_URL}/cancel`,
            userId,
        );
    }

    async createPortalSession(userId: string) {
        const user = await this.userRepository.findById(userId);
        if (!user?.stripeCustomerId) throw new Error('No Stripe customer found for this user');

        return this.stripeAdapter.createPortalSession(
            user.stripeCustomerId,
            `${process.env.FRONTEND_URL}/dashboard`,
        );
    }

    async handleWebhook(rawBody: Buffer, signature: string) {
        let event: ReturnType<typeof this.stripeAdapter.constructEvent>;
        try {
            event = this.stripeAdapter.constructEvent(rawBody, signature);
        } catch (err: any) {
            throw new Error(`Webhook signature verification failed: ${err.message}`);
        }

        switch (event.type) {
            case 'checkout.session.completed': {
                const session = event.data.object as any;
                const userId = session.client_reference_id as string;
                if (userId && session.customer) {
                    const user = await this.userRepository.findById(userId);
                    if (user) {
                        const updatedUser = user.withStripeCustomerId(session.customer as string);
                        await this.userRepository.save(updatedUser);
                    }
                }
                console.log('Checkout completed for user:', userId);
                break;
            }
            default:
                console.log('Unhandled Stripe event:', event.type);
        }

        return { received: true };
    }
}
