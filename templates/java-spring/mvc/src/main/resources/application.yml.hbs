spring:
  application:
    name: {{projectNameKebabCase}}
  datasource:
    url: jdbc:postgresql://localhost:5432/{{projectNameSnakeCase}}
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

server:
  port: 8080

logging:
  level:
    root: INFO
    {{packageName}}: DEBUG

jwt:
  secret: ${JWT_SECRET:{{jwtSecretKey}}}
  expiration: 604800000

stripe:
  secret-key: ${STRIPE_SECRET_KEY:sk_test_dummy}
  webhook-secret: ${STRIPE_WEBHOOK_SECRET:whsec_dummy}

frontend:
  url: ${FRONTEND_URL:http://localhost:3000}
